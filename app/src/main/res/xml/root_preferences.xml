<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
>
    <PreferenceCategory app:title="Data Upload Interval">
        <EditTextPreference
            app:key="delay_value"
            app:title="Delay Value"
            app:summary="Enter the delay amount (e.g. 5)"
            android:inputType="number"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:key="delay_unit"
            app:title="Delay Unit"
            app:summary="Select the unit for the delay"
            app:entries="@array/delay_unit_entries"
            app:entryValues="@array/delay_unit_values"
            app:defaultValue="seconds"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="MQTT Settings">
        <EditTextPreference
            app:key="mqtt_broker"
            app:title="Broker URL"
            app:summary="Enter the MQTT broker URI (e.g. tcp://example.com:1883)"
            app:useSimpleSummaryProvider="false" />

        <EditTextPreference
            app:key="mqtt_username"
            app:title="MQTT Username"
            app:summary="Enter your MQTT username"
            app:useSimpleSummaryProvider="false" />

        <EditTextPreference
            app:key="mqtt_password"
            app:title="MQTT Password"
            app:summary="Enter your MQTT password"
            android:inputType="textPassword"
            app:useSimpleSummaryProvider="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="UvRVRV">
        <EditTextPreference
            app:key="vid_url"
            app:title="URL"
            app:summary="Enter the URL to the UvRVRV server"
            app:useSimpleSummaryProvider="false" />
    </PreferenceCategory>

</PreferenceScreen>